{
  "name": "ai-avatar-overlay",
  "version": "0.0.2",
  "description": "Chrome extension that displays an animated avatar overlay on AI chat websites",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsc --noEmit && node scripts/build.js",
    "verify:build": "node scripts/verifyBuild.js",
    "build:old": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/node": "^20.12.7",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "@vitest/coverage-v8": "^1.5.0",
    "esbuild": "^0.27.0",
    "eslint": "^8.57.0",
    "happy-dom": "^14.7.1",
    "typescript": "^5.4.5",
    "vite": "^5.2.10",
    "vite-plugin-static-copy": "^1.0.4",
    "vitest": "^1.5.0"
  }
}
